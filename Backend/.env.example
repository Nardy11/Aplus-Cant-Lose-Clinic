# Backend environment
# Copy this file to .env and fill in your local secrets.
# Get the connection string directly from MongoDB Atlas > Connect > Drivers.
# If you use mongodb+srv://, the network DNS resolver must support SRV/TXT lookups.
MONGO_URI=mongodb+srv://nardy:<URL_ENCODED_MONGODB_PASSWORD>@cluster.k4jeaob.mongodb.net/AplusClinic?retryWrites=true&w=majority
TOKEN_SECRET=<YOUR_JWT_SECRET>
STRIPE_PRIVATE_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>
# From the Stripe dashboard (Developers > Webhooks) or `stripe listen`; starts with whsec_
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
# Public address of the web app; Stripe sends people back here after paying.
FRONTEND_URL=http://localhost:3000
EMAIL=<YOUR_EMAIL>
EMAIL_PASSWORD=<YOUR_EMAIL_APP_PASSWORD>
